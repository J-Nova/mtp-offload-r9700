@@ -99,7 +99,19 @@ RUN mkdir -p /wheels
 
 # --- torch (AOTriton off: its gfx1201 source-configure fails and vLLM never uses torch
 #     SDPA-flash; USE_MAGMA=0: base has no magma) ---
-RUN git clone --depth 1 -b v${TORCH_VERSION} --recurse-submodules --shallow-submodules \
+# GitHub rate-limits the anonymous burst of ~100 submodule fetches this clone makes and answers
+# with a 401 ("could not read Username"); the repos are public. Authenticate the fetches with a
+# token passed as a build secret -- --mount=type=secret is not stored in the layer, so the token
+# is never baked. GIT_CONFIG_* env is inherited by the submodule child processes (a plain
+# `git -c` would not be). If the secret is absent this falls back to the anonymous clone.
+RUN --mount=type=secret,id=github_token \
+    TOKEN="$(cat /run/secrets/github_token 2>/dev/null || true)"; \
+    if [ -n "$TOKEN" ]; then \
+      export GIT_CONFIG_COUNT=1 \
+             GIT_CONFIG_KEY_0="url.https://x-access-token:${TOKEN}@github.com/.insteadOf" \
+             GIT_CONFIG_VALUE_0="https://github.com/"; \
+    fi; \
+    git clone --depth 1 -b v${TORCH_VERSION} --recurse-submodules --shallow-submodules \
         https://github.com/pytorch/pytorch.git /src/pytorch \
     && cd /src/pytorch \
     && pip install -r requirements.txt \
@@ -222,19 +234,17 @@ ENV ROCM_PATH=/opt/rocm HIP_PATH=/opt/rocm HIP_PLATFORM=amd \
     SAFETENSORS_FAST_GPU=1 TOKENIZERS_PARALLELISM=false TRITON_CACHE_AUTOTUNING=1 \
