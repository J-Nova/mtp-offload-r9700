+  # optional extension with the documented gate breaks the recursion; vLLM only loses the
+  # EnvTensorAllocator fast path, not correctness. Override with TVM_FFI_DISABLE_TORCH_C_DLPACK=0.
+  if [ "$TVM_FFI_DISABLE_TORCH_C_DLPACK" = 0 ]; then TVM_FFI_DISABLE_TORCH_C_DLPACK=1; fi
